generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  password      String
  email         String        @unique
  active        Int?          @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profileId     Int
  verified      Int?          @default(0)
  verifiedToken String?
  lastname      String
  name          String
  address       String?
  country       String        @default("EC")
  middlename    String
  phone         String?       @db.VarChar(20)
  postCode      String?
  payment       Payment[]
  transaction   Transaction[]
  profile       Profile       @relation(fields: [profileId], references: [id])
}

model Profile {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  active      Int?          @default(1)
  roles       ProfileRole[]
  users       User[]
}

model Role {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  active      Int?          @default(1)
  profiles    ProfileRole[]
  entities    RoleEntity[]
}

model RoleEntity {
  id         Int      @id @default(autoincrement())
  roleId     Int
  entityId   Int
  assignedAt DateTime @default(now())
  entity     Entity   @relation(fields: [entityId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([roleId, entityId])
}

model ProfileRole {
  id         Int      @id @default(autoincrement())
  profileId  Int
  roleId     Int
  assignedAt DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
}

model Param {
  id     Int    @id @default(autoincrement())
  key    String @unique
  value  String
  active Int?   @default(1)
}

model Debt {
  id                    Int       @id @default(autoincrement())
  titleName             String?
  liquidationCode       String
  shopperName           String
  identification        String?
  courtCosts            Int?
  localCode             String?
  plotId                Int?
  actionLiquidationType Int
  liquidationState      Int
  year                  Int
  surcharge             Float?    @default(0)
  discount              Float?    @default(0)
  interest              Float?    @default(0)
  coercive              Float?    @default(0)
  totalAmount           Float
  createdAt             DateTime  @default(now())
  liquidationId         Int
  payment               Payment[]
}

model Payment {
  id                 Int         @id @default(autoincrement())
  customerId         Int
  cashier            Int         @default(30)
  createdAt          DateTime    @default(now())
  debtId             Int
  ipSession          String?
  macAddressUser     String?
  observation        String?
  receiptNumber      String
  bank_id            Int
  cardAuthorization  String      @db.VarChar
  cardExpirationDate String      @db.VarChar
  cardHolderName     String      @db.VarChar
  cardNumber         String      @db.VarChar
  cardVoucherNumber  String      @db.VarChar
  message            String
  transactionId      Int
  amount             Float
  customer           User        @relation(fields: [customerId], references: [id])
  debt               Debt        @relation(fields: [debtId], references: [id])
  transaction        Transaction @relation(fields: [transactionId], references: [id])
}

model Transaction {
  state          String
  acquirerId     Int
  amount         Float
  authorization  Int
  bankResponse   String?
  buttonResponse String
  executionDate  DateTime  @default(now())
  interest       Float?    @default(0)
  lot            String?
  order          Int       @default(autoincrement())
  reference      String?
  responseText   String?
  totalAmount    Float
  trxId          String    @unique
  type           String?
  id             Int       @id @default(autoincrement())
  jsonResponse   String
  payment        Payment[]
  acquirer       User      @relation(fields: [acquirerId], references: [id])
}

model Entity {
  name        String       @unique
  description String?
  active      Int?         @default(1)
  id          Int          @id @default(autoincrement())
  RoleEntity  RoleEntity[]
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  entityDescription String
  sent              Int      @default(0)
  email             String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  recordId          Int

  @@unique([entityDescription, recordId])
  @@index([entityDescription, recordId])
}

model cliente {
  id                              BigInt    @id @default(autoincrement())
  identificacion                  String?   @db.VarChar(250)
  ruc                             String?   @db.VarChar(3)
  tipo_identificacion             BigInt?
  nombre                          String?   @db.VarChar(250)
  apellido                        String?   @db.VarChar(250)
  direccion                       String?   @db.VarChar(250)
  email                           String?   @db.VarChar(500)
  telefono                        String?   @db.VarChar(250)
  celular                         String?   @db.VarChar(250)
  fecha_nacimiento                DateTime? @db.Date
  genero                          BigInt?
  discapacidad                    Boolean?  @default(false)
  num_conadis                     String?   @db.VarChar(10)
  estado                          Boolean?  @default(true)
  identificacion_generada         Boolean?  @default(false)
  usuario_creacion                String?   @db.VarChar(100)
  fecha_creacion                  DateTime? @db.Timestamp(6)
  usuario_modificacion            String?   @db.VarChar(100)
  fecha_modificacion              DateTime? @db.Timestamp(6)
  clasificacion_prov              BigInt?
  tipo_prov                       BigInt?
  contribuyente_especial          Boolean?
  resolucion_sri                  String?   @db.VarChar(255)
  tipo_de_negocio                 String?   @db.VarChar(255)
  canton                          BigInt?
  porcentaje_discapacidad         Int?      @db.SmallInt
  enfermedad_catastrofica         Boolean?  @default(false)
  estado_civil                    String?   @db.VarChar
  es_persona                      Boolean?  @default(true)
  nombre_comercial                String?   @db.VarChar(255)
  razon_social                    String?   @db.VarChar(255)
  titulo_prof                     String?   @db.VarChar(255)
  codigo                          String?   @db.VarChar(250)
  contribuyente_cementerio        Boolean?  @default(false)
  apellido_casada                 String?   @db.VarChar(250)
  interno                         Boolean?  @default(true)
  sexo                            Boolean?
  tipo_persona                    String?   @db.VarChar(10)
  validado                        Boolean?  @default(false)
  contribuyente_cementerio_nombre String?   @db.VarChar
  tiene_ruc                       Boolean?  @default(false)
  usuario_validador               BigInt?
  consolidado                     String?   @db.VarChar(500)
  multi_propietario               Boolean?  @default(false)
  valiador_asignado               BigInt?
  valid_nodos                     Boolean?  @default(false)
  id_referencias_consolidados     String?   @db.VarChar
  valid_admin                     Boolean?  @default(false)
  representante_legal             String?   @db.VarChar
  id_representante_legal          BigInt?
  condicion_ciudadano             String?   @db.VarChar
  fecha_expedicion                DateTime? @db.Timestamp(6)

  @@index([id])
  @@index([codigo], map: "cliente_idx_codigo")
  @@index([apellido], map: "idx_cliente_apellido")
  @@index([fecha_modificacion], map: "idx_cliente_fecha")
  @@index([identificacion], map: "idx_cliente_identificacion")
  @@index([nombre], map: "idx_cliente_nombre")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model deuda {
  recargo    Decimal? @db.Decimal(10, 2)
  descuento  Decimal? @db.Decimal(10, 2)
  interes    Decimal? @db.Decimal(10, 2)
  coactiva   Decimal? @db.Decimal(10, 2)
  total_pago Decimal? @db.Decimal(10, 2)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model predio {
  clave_cat     String? @db.VarChar(100)
  id_predio     BigInt?
  codigo_predio String? @db.VarChar

  @@ignore
}
